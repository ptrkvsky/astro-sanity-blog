---
import type { Comment } from '@interfaces/SanitySchema';
import { formatArticleDate } from '../functions/articleContent';
interface Props {
  comment: Comment;
}
const { comment } = Astro.props;
---

<article class="blog-comment">
  <p class="blog-meta">
    <span>{comment.pseudo}</span>
    <time datetime={comment._createdAt}>
      {formatArticleDate(comment._createdAt)}
    </time>
  </p>
  <p>{comment.content}</p>
</article>
