---
import type { QuestionsAnswers, SanityKeyed } from '@interfaces/SanitySchema';
interface Props {
  questionsAnswers: Array<SanityKeyed<QuestionsAnswers>>;
}
const { questionsAnswers } = Astro.props;
---

<section class="blog-faq blog-end-section">
  <h2>Questions fréquentes</h2>
  {questionsAnswers.map((item) => (
    <article>
      <h3>{item.question}</h3>
      <p>{item.answer}</p>
    </article>
  ))}
</section>
