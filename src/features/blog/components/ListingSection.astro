---
import type { CategoryPosts } from '@features/blog/interfaces/CategoryPosts';
import PostCard from './PostCard/index.astro';
interface Props {
  categoryPosts: CategoryPosts;
}
const {
  categoryPosts: { category, posts },
} = Astro.props;
---

<section class="blog-list-section">
  <header class="blog-section-heading">
    <h2>
      {category.slug?.current ? (
        <a href={`/categorie/${category.slug.current}`}>{category.title}</a>
      ) : (
        category.title
      )}
    </h2>
    <p class="blog-meta">
      {posts.length} article{posts.length > 1 ? 's' : ''}
    </p>
  </header>
  <ul class="blog-entries">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </ul>
</section>
