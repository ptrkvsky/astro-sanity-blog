---
import type { Post } from '@interfaces/SanitySchema';
import { formatArticleDate } from '../../functions/articleContent';
interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
}
const { post, headingLevel: Heading = 'h3' } = Astro.props;
const date = formatArticleDate(post._createdAt);
---

<li class="blog-entry">
  <article>
    {date && (
      <p class="blog-meta">
        <time datetime={post._createdAt}>{date}</time>
      </p>
    )}
    <Heading>
      <a href={`/posts/${post.slug.current}`}>{post.title}</a>
    </Heading>
    {post.description && <p class="blog-excerpt">{post.description}</p>}
  </article>
</li>
