---
import type { Comment } from '@interfaces/SanitySchema';
import CommentCard from './CommentCard.astro';
interface Props {
  comments: Comment[] | { error: unknown };
  postTitle?: string;
}
const { comments } = Astro.props;
---

{Array.isArray(comments) && comments.length > 0 && (
  <section class="blog-end-section">
    <h2>Commentaires publiés</h2>
    {comments.map((comment) => (
      <CommentCard comment={comment} />
    ))}
  </section>
)}
{!Array.isArray(comments) && (
  <p>Les commentaires sont momentanément indisponibles.</p>
)}
