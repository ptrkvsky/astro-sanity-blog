---
import type { Post } from '@interfaces/SanitySchema';
import PostCard from '../PostCard/index.astro';
interface Props {
  relatedPosts: Post[];
}
const { relatedPosts } = Astro.props;
---

<section class="blog-related blog-list-section">
  <h2>Pour poursuivre la lecture</h2>
  <ul class="blog-entries">
    {relatedPosts.map((post) => (
      <PostCard post={post} />
    ))}
  </ul>
</section>
