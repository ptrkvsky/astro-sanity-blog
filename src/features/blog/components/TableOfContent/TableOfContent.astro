---
import type { Heading } from '@features/blog/interfaces/Heading';
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
---

<details class="blog-toc" open>
  <summary>Dans cet article</summary>
  <nav id="table-of-content" aria-label="Sommaire de l’article">
    <ol>
      {headings.map((heading) => (
        <li class={`toc-depth-${heading.hn}`}>
          <a href={`#${heading.id}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
</details>
