---
// Repère de calage (un symbole, deux plaques) et motifs de trame partagés par toute la page.
---

<svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <g id="repere">
      <circle r="31" fill="none" stroke="currentColor" vector-effect="non-scaling-stroke"></circle>
      <path d="M-48 0H48M0-48V48" fill="none" stroke="currentColor" vector-effect="non-scaling-stroke"></path>
      <circle r="12" fill="currentColor"></circle>
      <path d="M-12 0H12M0-12V12" fill="none" style="stroke: var(--knock, #121210)" vector-effect="non-scaling-stroke"></path>
    </g>
    <pattern id="tint-paper-50" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><circle cx="4" cy="4" r="2.3" fill="#F1EEE6"></circle></pattern>
    <pattern id="tint-paper-25" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><circle cx="4" cy="4" r="1.4" fill="#F1EEE6"></circle></pattern>
    <pattern id="tint-red-50" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(15)"><circle cx="4" cy="4" r="2.3" fill="#FF5A36"></circle></pattern>
    <pattern id="tint-over" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(15)"><rect width="8" height="8" fill="#FF5A36"></rect><circle cx="4" cy="4" r="2" fill="#F1EEE6"></circle></pattern>
  </defs>
</svg>
