---
import Repere from './Repere.astro';
import { methode } from '../content';
---

<section class="sec page" id="methode" aria-labelledby="t-methode">
  <header class="sec-head g12">
    <p class="sec-num" aria-hidden="true">01</p>
    <h2 id="t-methode">{methode.title}</h2>
    <p class="note">{methode.note}</p>
  </header>
  <div class="pipeline">
    <p class="pipeline-counter" aria-hidden="true"><b>01</b><span>{methode.steps[0].browser}</span><i>{methode.steps[0].print}</i></p>
    <div class="steps-wrap">
      <div class="axis-head" aria-hidden="true"><Repere /></div>
      <ol class="steps">
        {
          methode.steps.map((s) => (
            <li class="step">
              <Repere class="step-mark mark" />
              <p class="step-pair">
                <span>{s.browser}</span> · {s.print}
              </p>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="layer-control">
        <button type="button" class="btn" data-remove-layer hidden>Retirer la couche créative</button>
        <span class="note" role="status" aria-live="polite" data-layer-status></span>
      </p>
    </div>
  </div>
</section>
