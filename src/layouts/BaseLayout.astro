---
import '@assets/style/global.css';
import '@assets/style/epreuve.css';
import type { Graph, WithContext } from 'schema-dts';
import type { BlogPosting } from 'schema-dts';
import SiteHeader from '@components/SiteHeader.astro';
import SiteFooter from '@components/SiteFooter.astro';
import Favicons from '@components/Favicons.astro';
import { seoConfig } from '../config';

interface Props {
  title: string;
  description: string;
  canonical: string;
  schema?: WithContext<BlogPosting> | Graph;
  image?: string;
}

const { title, schema, description, image, canonical } = Astro.props as Props;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta
      name="google-site-verification"
      content="hYnFEHeU0yp9Wsa8c3QfTnVFqMAuCsAk-y6qF0A_XjQ"
    />
    <meta property="og:locale" content="fr_FR" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="jungleup" content="ed238befefc41b3e8840277869cc1c67" />
    {image && <meta property="og:image" content={image} />}
    {
      schema && (
        <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
      )
    }
    <link
      rel="preload"
      href="/assets/fonts/instrument-serif-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <Favicons />
    {
      canonical && (
        <link rel="canonical" href={new URL(canonical, Astro.site || seoConfig.productionURL).href} />
      )
    }
    <!-- <link rel="manifest" href="/manifest.webmanifest" /> -->
    <meta name="theme-color" content="#121210" />
  </head>
  <body id="haut">
    <a class="skip" href="#contenu">Aller au contenu</a>
    <SiteHeader />
    <main id="contenu">
      <slot name="main" />
    </main>
    <SiteFooter />
  </body>
</html>
<style is:global>
  .conteneur {
    @apply mx-2 md:mx-auto;
  }
</style>
