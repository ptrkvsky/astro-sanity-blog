---
import '@assets/style/blog.css';
import PostCard from '@features/blog/components/PostCard/index.astro';
import ArticleBreadcrumb from '@features/blog/components/ArticleBreadcrumb.astro';
import { getCategoriesUrlParams } from '@features/blog/functions/getCategoriesUrlParams';
import type { Category } from '@features/blog/interfaces/Category';
import type { SanityAllCategories } from '@features/blog/interfaces/SanityAllCategories';
import { queryAllCategories } from '@features/blog/queries/queryAllCategories';
import fetchSanity from '@helpers/fetchSanity';
import type { Post } from '@interfaces/SanitySchema';
import BaseLayout from '@layouts/BaseLayout.astro';
import { client } from '@lib/sanityClient';
import { sortPosts } from '@features/blog/functions/articleContent';
import getSchemaBlogListing from 'src/helpers/getSchemaBlogListing';

interface Props {
  category: Category;
}
export const prerender = true;
export async function getStaticPaths() {
  const result = await fetchSanity<SanityAllCategories>(queryAllCategories);
  if (!result) throw new Error('Blog : chargement des catégories impossible');
  return getCategoriesUrlParams(result);
}
const { category } = Astro.props;
const posts = sortPosts(
  await client.fetch<Post[]>(
    '*[_type == "post" && defined(slug.current) && references($categorieId)]',
    { categorieId: category._id },
  ),
);
const title = `Articles ${category.title} — Johan Petrikovsky`;
const description =
  category.description ||
  `Articles et retours d’expérience sur ${category.title}, par Johan Petrikovsky, développeur frontend.`;
const path = `/categorie/${category.slug.current}`;
const schema = getSchemaBlogListing({ title, description, path, posts });
---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
  canonical={path}
>
  <div slot="main" class="blog page">
    <ArticleBreadcrumb
      items={[
        { name: 'Accueil', path: '/' },
        { name: 'Articles', path: '/posts' },
        { name: category.title },
      ]}
    />
    <header class="blog-header">
      <p class="blog-kicker">Le journal · Catégorie</p>
      <h1>
        {category.title}
        <span class="blog-title-dot" aria-hidden="true">
          .
        </span>
      </h1>
      {category.description && <p class="blog-intro">{category.description}</p>}
      <p class="blog-meta">
        {posts.length} article{posts.length > 1 ? 's' : ''} ·{' '}
        <a href="/posts">Tous les articles</a>
      </p>
    </header>
    <ul class="blog-entries">
      {posts.map((post) => (
        <PostCard post={post} headingLevel="h2" />
      ))}
    </ul>
    {posts.length === 0 && (
      <p class="blog-empty">
        Aucun article dans cette catégorie pour le moment.{' '}
        <a href="/posts">Parcourir le journal</a>.
      </p>
    )}
  </div>
</BaseLayout>
