---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getGraphHome } from '@helpers/getGraphHome';
import { client } from 'src/lib/sanityClient';
import '@assets/style/calage.css';
import Defs from '@features/home-epreuve/components/Defs.astro';
import Hero from '@features/home-epreuve/components/Hero.astro';
import Methode from '@features/home-epreuve/components/Methode.astro';
import Essais from '@features/home-epreuve/components/Essais.astro';
import Controle from '@features/home-epreuve/components/Controle.astro';
import APropos from '@features/home-epreuve/components/APropos.astro';
import Repere from '@features/home-epreuve/components/Repere.astro';
import BonATirer from '@features/home-epreuve/components/BonATirer.astro';

const description =
  'Développeur React freelance et créateur de site internet depuis 2012. Spécialisé dans le développement front de site web en Javascript avec React.';

interface Note {
  title: string;
  slug: string;
  category?: string;
}

// Les quatre derniers articles : si Sanity ne répond pas, la section est simplement omise.
let notes: Note[] = [];
let articleCount: number | undefined;
try {
  const result = await client.fetch<{ notes: Note[]; count: number }>(
    `{
      "notes": *[_type == "post" && defined(slug.current)] | order(_createdAt desc)[0...4]{
        title, "slug": slug.current, "category": categories[0]->title
      },
      "count": count(*[_type == "post" && defined(slug.current)])
    }`,
  );
  notes = result.notes.map((n) => ({ ...n, title: n.title.trim() }));
  articleCount = result.count;
} catch (error) {
  console.error('Accueil : lecture des articles impossible', error);
}

const schema = getGraphHome();
---

<BaseLayout
  title="Développeur React et Typescript Freelance"
  description={description}
  schema={schema}
  canonical="/"
>
  <div slot="main">
    <Defs />
    <Hero />
    <Methode />
    <Essais />
    <Controle />
    <APropos notes={notes} articleCount={articleCount} />
    <BonATirer />
    <div class="calage-meter" aria-hidden="true"><span>Calage</span><b><output data-calage>100</output> %</b><i></i></div>
    <div class="courier" aria-hidden="true"><Repere /></div>
  </div>
</BaseLayout>

<script>
  // Couche d'expérience : chargée après le contenu, jamais sur les autres pages.
  import '../scripts/experience/index.js';
</script>
