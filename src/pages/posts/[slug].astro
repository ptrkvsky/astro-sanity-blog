---
import '@assets/style/blog.css';
import { toHTML } from '@portabletext/to-html';
import type { SanityAllPost } from '@features/blog/interfaces/SanityAllPost';
import type { Post } from '@interfaces/SanitySchema';
import BaseLayout from '@layouts/BaseLayout.astro';
import TableOfContent from '@features/blog/components/TableOfContent/TableOfContent.astro';
import ObserverTableOfContent from '@features/blog/scripts/ObserverTableOfContent.astro';
import ArticleBreadcrumb from '@features/blog/components/ArticleBreadcrumb.astro';
import fetchSanity from '@helpers/fetchSanity';
import { queryAllPosts } from '@features/blog/queries/queryAllPosts';
import { getPostsUrlParams } from '@features/blog/functions/getPostsUrlParams';
import {
  articleHeadings,
  prepareArticleBlocks,
  formatArticleDate,
} from '@features/blog/functions/articleContent';
import { createPortableTextComponents } from '@helpers/portableTextComponents';
import { getGraphBlogPost } from '@helpers/getGraphBlogPost';
import FormComment from '@features/blog/components/FormComment/FormComment';
import getPostComments from '@features/blog/functions/getPostsComments';
import SectionComments from '@features/blog/components/SectionComments.astro';
import Faq from '@features/blog/components/Faq.astro';
import SectionPosts from '@features/blog/components/SectionPosts/SectionPosts.astro';

interface Props {
  post: Post;
  relatedPosts: Post[];
}
export const prerender = true;
export async function getStaticPaths() {
  const result = await fetchSanity<SanityAllPost>(queryAllPosts);
  if (!result?.allPost)
    throw new Error('Blog : chargement des articles impossible');
  return getPostsUrlParams(result);
}
const { post, relatedPosts } = Astro.props;
const blocks = prepareArticleBlocks(post.bodyRaw || []);
const [comments, components] = await Promise.all([
  getPostComments(post._id),
  createPortableTextComponents(blocks),
]);
const postContent = toHTML(blocks, { components });
const headings = articleHeadings(post.bodyRaw || []);
const categories = (post.categories || []).filter(
  (category) => category?.slug?.current,
);
const category = categories[0];
const breadcrumb = [
  { name: 'Accueil', path: '/' },
  { name: 'Articles', path: '/posts' },
  ...(category
    ? [{ name: category.title, path: `/categorie/${category.slug.current}` }]
    : []),
  { name: post.title },
];
const title = post.seoTitle?.trim() || `${post.title} — Johan Petrikovsky`;
const description =
  post.seoDescription?.trim() ||
  post.description?.trim() ||
  `Un article de Johan Petrikovsky : ${post.title}.`;
const date = formatArticleDate(post._createdAt);
const questionsAnswers = post.questionsAnswers || [];
---

<BaseLayout
  title={title}
  schema={getGraphBlogPost(post)}
  description={description}
  image={post.seoImage?.asset?.url}
  canonical={`/posts/${post.slug.current}`}
>
  <div slot="main" class="blog blog-article page">
    <ArticleBreadcrumb items={breadcrumb} />
    <header class="blog-header blog-article-header">
      <p class="blog-kicker">
        Le journal
        {categories.map((category) => (
          <>
            {' '}
            ·{' '}
            <a href={`/categorie/${category.slug.current}`}>{category.title}</a>
          </>
        ))}
      </p>
      <h1 id="article-title">{post.title}</h1>
      {post.description && <p class="blog-intro">{post.description}</p>}
      <p class="blog-meta">
        <a href="/#a-propos">Johan Petrikovsky</a>
        {date && (
          <span>
            Créé le <time datetime={post._createdAt}>{date}</time>
          </span>
        )}
      </p>
    </header>
    <div class:list={['blog-reading-grid', { 'has-toc': headings.length > 0 }]}>
      {headings.length > 0 && (
        <aside class="blog-sidebar">
          <TableOfContent headings={headings} />
        </aside>
      )}
      <div class="blog-reading-column">
        <article
          class="post-content"
          aria-labelledby="article-title"
          set:html={postContent}
        />
        {questionsAnswers.length > 0 && (
          <Faq questionsAnswers={questionsAnswers} />
        )}
        {relatedPosts.length > 0 && (
          <SectionPosts relatedPosts={relatedPosts} />
        )}
        <section class="blog-contact blog-end-section">
          <p class="blog-kicker">Du code au projet</p>
          <h2>Une interface à rendre plus solide ?</h2>
          <p>
            Performance, accessibilité, architecture frontend :{' '}
            <a href="/#contact">parlons de votre projet</a>.
          </p>
        </section>
        <section id="commentaires" class="blog-end-section">
          <FormComment
            client:visible
            postId={post._id}
            postTitle={post.title}
          />
          <noscript>
            <p>
              Pour envoyer un commentaire, activez JavaScript ou{' '}
              <a href="/#contact">contactez-moi directement</a>. Les
              commentaires publiés restent consultables ci-dessous.
            </p>
          </noscript>
          <SectionComments comments={comments} />
        </section>
      </div>
    </div>
    <ObserverTableOfContent />
  </div>
</BaseLayout>
